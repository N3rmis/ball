[layer_names]

3d_render/layer_1="Player"
3d_render/layer_2="World"
3d_render/layer_3="Obsticals"
3d_physics/layer_1="Player"
3d_physics/layer_2="World"
3d_physics/layer_3="Obsticles"

[physics]

common/max_physics_steps_per_frame=4
common/physics_interpolation=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_s3tc_bptc=true
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=1024
lights_and_shadows/directional_shadow/size.mobile=1024
